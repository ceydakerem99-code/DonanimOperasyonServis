{
  "firestore": {
    "database": "(default)",
    "location": "europe-west1",
    "rules": "FirebaseRules/firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "web-survey/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/survey/**",
        "function": "surveyApi"
      },
      {
        "source": "/survey/**",
        "destination": "/survey/index.html"
      }
    ]
  },
  "functions": {
    "source": "functions"
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
